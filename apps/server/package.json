{
  "name": "@tenet/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist && bun build scripts/auth.ts --target=bun --outfile=dist/auth.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.7",
    "@tenet/api": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tenet/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2"
  }
}
