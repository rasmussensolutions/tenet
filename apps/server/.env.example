# Development. Use a public HTTPS origin in production. No trailing slash.
TENET_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://tenet:change-me@localhost:5432/tenet
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
PORT=3002
HOST=127.0.0.1
# Production: serve the built dashboard from the same origin as the API.
# TENET_ASSETS_DIR=../../apps/dashboard/dist/client

# Optional: serve an externally prepared daemon artifact directory.
# Otherwise use bundled dashboard assets (or dashboard/public/daemon in development).
# TENET_DAEMON_DIST=/absolute/path/to/daemon

# Optional signed daemon updates (configure both). No private signing key on the panel.
# TENET_RELEASE_URL=https://github.com/OWNER/REPO/releases/latest/download/release.json
# TENET_RELEASE_PUBLIC_KEY=<64-character Ed25519 public key; see docs/updates.md>
