{
  "name": "tenet",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @tenet/dashboard --filter @tenet/website --filter @tenet/server dev",
    "dev:dashboard": "bun run --filter @tenet/dashboard dev",
    "dev:website": "bun run --filter @tenet/website dev",
    "dev:server": "bun run --filter @tenet/server dev",
    "dev:worker": "bun run --filter @tenet/worker dev",
    "build": "bun run --filter @tenet/dashboard build && bun run --parallel --filter @tenet/website --filter @tenet/server build && bun run --filter @tenet/worker build",
    "build:daemon": "cargo build --release --package tenetd",
    "typecheck": "bun run --filter '@tenet/*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run check:daemon",
    "check:daemon": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "auth:admin": "bun apps/server/scripts/auth.ts",
    "test": "bun test packages/api/test",
    "bundle:daemon": "bun scripts/bundle-daemon.ts",
    "dev:tunnel": "bun --env-file=apps/server/.env scripts/dev-tunnel.ts",
    "release:daemon": "bun scripts/release-daemon.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2"
  }
}
